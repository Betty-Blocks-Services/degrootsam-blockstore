{
  "description": "Search an array of primitives or objects and return the first item that matches a condition.",
  "label": "Array Find",
  "category": "Array",
  "icon": {
    "name": "ListIncredementIcon",
    "color": "Blue"
  },
  "options": [
    {
      "name": "array",
      "label": "Array",
      "meta": {
        "type": "Value",
        "allowedKinds": ["ARRAY", "COLLECTION"],
        "validations": {
          "required": true
        }
      },
      "info": "The array to search."
    },
    {
      "name": "path",
      "label": "Path",
      "meta": {
        "type": "Text",
        "validations": {
          "required": true
        }
      },
      "info": "If the array contains objects, the dot-separated path to the property to match on. For example, 'user.name'"
    },
    {
      "name": "value",
      "label": "Value",
      "meta": {
        "type": "Value",
        "allowedKinds": ["STRING", "INTEGER"],
        "validations": {
          "required": true
        }
      },
      "info": "The value to compare each item (or the property at Path) against."
    },
    {
      "name": "operator",
      "label": "Operator",
      "meta": {
        "type": "Select",
        "values": [
          {
            "label": "Equal",
            "value": "eq"
          },
          {
            "label": "Not Equal",
            "value": "ne"
          },
          {
            "label": "Greater Than",
            "value": "gt"
          },
          {
            "label": "Greater Than or Equal",
            "value": "gte"
          },
          {
            "label": "Less Than",
            "value": "lt"
          },
          {
            "label": "Less Than or Equal",
            "value": "lte"
          },
          {
            "label": "Contains",
            "value": "cont"
          },
          {
            "label": "Does Not Contain",
            "value": "nCont"
          }
        ]
      },
      "info": "The comparison operator to apply when evaluating each item against Value."
    },
    {
      "name": "schemaModel",
      "label": "Schema Model",
      "meta": {
        "type": "SchemaModel"
      },
      "info": "The schema model to use for the output type."
    },
    {
      "name": "resultModel",
      "label": "Result as model",
      "meta": {
        "type": "Output",
        "output": {
          "type": "Record",
          "model": "array"
        }
      },
      "info": "The matching item, typed to the source array's model."
    },
    {
      "name": "resultSchema",
      "label": "Result as schema model",
      "meta": {
        "type": "Output",
        "output": {
          "anyOf": [
            { "type": "Object", "schemaModel": "schemaModel" },
            {
              "type": "Array",
              "dataType": "SCHEMA",
              "schemaModel": "schemaModel"
            },
            { "type": "Text" },
            { "type": "Boolean" },
            { "type": "Number" }
          ]
        }
      },
      "info": "The matching item, typed to the selected Schema Model."
    }
  ],
  "yields": "NONE"
}
